# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.

# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB = "ubg_events"

# AI that reads the paper forms: "gemini" or "anthropic" (only one key is needed).
AI_PROVIDER = "gemini"
# Google AI Studio (aistudio.google.com > Get API key). Free tier: Google may use submitted content to
# improve its products and human reviewers may read it -- see Google's Gemini API terms.
GEMINI_API_KEY = "AIza..."
# Optional: GEMINI_MODEL = "gemini-3.5-flash-lite"
# Anthropic alternative (paid; data not used for training):
# ANTHROPIC_API_KEY = "sk-ant-..."

# Random long string; used to sign QR codes. Never change it after cards are printed.
QR_SECRET = "change-me-to-a-long-random-string"

# --- Who can use the app -------------------------------------------------------------------
# Default (no [auth] section): make the app PRIVATE on Streamlit Community Cloud and invite the
# volunteers' emails there. Inside the app everyone can scan; admin pages unlock with this PIN.
ADMIN_PIN = "choose-a-pin-only-admins-know"
# Optional, only for local testing on your own computer (ignored on a real server):
# DEV_LOGIN_EMAIL = "you@example.com"
# Only used with Google sign-in ([auth] below): this Gmail is always admin.
BOOTSTRAP_ADMIN_EMAIL = "you@example.com"

# Public URL of the app (used as OAuth redirect for Google Sheets)
APP_URL = "http://localhost:8501"

# OPTIONAL Google sign-in (st.login) for per-person logins. Leave this section out to use the
# Streamlit-viewers + ADMIN_PIN setup above. Create an OAuth client (Web) in Google Cloud Console.
# Authorized redirect URIs:  {APP_URL}/oauth2callback
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "another-long-random-string"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Google Sheets connection (can reuse the same OAuth client as [auth]).
# Add {APP_URL} (exact, no path) as an extra Authorized redirect URI.
[google_sheets]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
